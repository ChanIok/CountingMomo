# xmake 本机配置、构建及分发产物
/.xmake/
/build/
/dist/
/compile_commands.json

# 扫描结果、裁图证据及本地实验材料
/data/
/results/
/temp/

# 原型代码与实验脚本仅本地保留，不再纳入版本管理
/prototype/

# Python 虚拟环境和缓存
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# 字体需自行准备；不随源码提交，保留字体说明及授权文件
/resources/fonts/*.ttf
/resources/fonts/*.otf
/resources/fonts/*.ttc

# 提交前钩子依赖；pnpm 安装后由 prepare 脚本注册 husky
/node_modules/

# 本机 IDE 状态及 Windows 缓存
/.vs/
*.suo
*.user
Thumbs.db
Desktop.ini

# 保留 xmake-requires.lock、布局 JSON、扫描素材和实验标注 JSON
